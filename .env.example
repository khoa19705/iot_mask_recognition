# Path to your trained Ultralytics YOLO weights (.pt)
MASK_MODEL_PATH=best.pt
MAX_UPLOAD_MB=8
PORT=5000
# Set to 1 only for local development
FLASK_DEBUG=0
# Keep local for laptop runs; set cloud only on the deployed server.
APP_ENV=local
# If best.pt is absent in Docker, provide an HTTPS download URL and its SHA256.
MODEL_URL=
MODEL_SHA256=
