# Local default; Docker uses best.onnx through its ENV instead.
MASK_MODEL_PATH=best.pt
MAX_UPLOAD_MB=8
PORT=5000
# Set to 1 only for local development
FLASK_DEBUG=0
# Keep local for laptop runs; set cloud only on the deployed server.
APP_ENV=local
# Optional alternative when the configured model file is absent.
MODEL_URL=
MODEL_SHA256=
